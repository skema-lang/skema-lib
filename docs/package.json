{
  "name": "@skema/docs",
  "version": "0.1.0",
  "description": "The skema model as Markdown reference documentation, shared by the browser editor and the VSCode extension.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/skema-language/skema-lib.git",
    "directory": "docs"
  },
  "type": "module",
